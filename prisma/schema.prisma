// PSP-Portal data model (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status/role are kept as plain strings (fixed vocabulary) so app code can pass
// literals freely. Postgres enums are an option later if you want DB-level checks:
//   Role:     CLIENT | TECHNICAL
//   TxStatus: PENDING | LINK_GENERATED | PAID | CREDITED | CREDIT_FAILED | FAILED

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("CLIENT")
  accounts  TradingAccount[]
  txns      Transaction[]
  createdAt DateTime @default(now())
}

model TradingAccount {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  // MT5 login (account number) this deposit will credit
  mt5Login  String
  label     String?  // friendly name shown in the form
  currency  String   @default("USD")
  group     String?  // MT5 group, optional override
  isActive  Boolean  @default(true)
  txns      Transaction[]
  createdAt DateTime @default(now())

  @@unique([userId, mt5Login])
}

model Transaction {
  id              String          @id @default(cuid())
  // Optional links — public (no-login) deposits leave these null and rely on
  // the fields below. Admin-created/registered deposits may still set them.
  user            User?           @relation(fields: [userId], references: [id])
  userId          String?
  account         TradingAccount? @relation(fields: [accountId], references: [id])
  accountId       String?

  // Public deposit details (entered on the open deposit page)
  mt5Login        String          // MT5 account number to credit
  clientEmail     String?
  clientName      String?

  amount          Float
  currency        String         @default("USD")
  status          String         @default("PENDING")

  // Our reference sent to Rival so we can correlate the payment
  reference       String         @unique

  // Rival / WhishPay
  rivalPaymentId  String?
  whishpayUrl     String?

  // MT5 result
  mt5DealId       String?
  mt5Message      String?

  // Free-form audit of provider payloads
  providerPayload String?        // JSON string of last provider/webhook payload
  errorMessage    String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// Singleton-style config rows edited from the Technical dashboard.

model ProviderConfig {
  id                String   @id @default("rival")
  apiKey            String?  // Rival company key: tsk_<prefix>_<secret> (sent as Bearer)
  baseUrl           String?  @default("https://staging.portal.rivalpayments.com/v1")
  createPaymentPath String?  @default("/integrations/whish/payments")
  statusPath        String?  @default("/integrations/whish/payments/{id}")
  healthPath        String?  @default("/health")
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model Mt5Config {
  id           String   @id @default("mt5")
  gatewayUrl   String?  // internal MT5 gateway base URL, e.g. http://localhost:4100
  gatewayKey   String?  // shared secret (x-api-key) for the gateway
  defaultGroup String?  // default MT5 group for deposits
  // MT5 Manager connection — entered in Settings, forwarded to the Python gateway.
  // NOTE: store-at-rest only; encrypt these columns before production use.
  mt5Server    String?  // server address:port, e.g. mt5.broker.com:443
  mt5Login     String?  // manager login (number)
  mt5Password  String?  // manager password
  enabled      Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}
